#researcher-hire-screen {
    width: 95%;
    height: 100%;
    background-color: #e5e5e5;
    font-size: 100%;
    color: black;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    -unity-font-style: bold;
}

#researchers {
    padding-top: 12px;
    flex-grow: 1; 
    flex-shrink: 1;
}

#researcher > * {
    flex-shrink: 0;
}

#cost-info, #researcher-overview {
    background-color: #FFA500;
}

#speciality-blurb, #back-to-upgrades {
    background-color: #7300FF;
}

#researcher-overview {
    display: flex;
    flex-direction: row;
    justify-content: space-around;
    align-items: center;
    padding: 8px 16px 0 16px;
}

#name-and-stats {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    flex-shrink: 0; 
    margin-right: 24px;
}

#back-to-upgrades {
    flex-shrink: 0;
    padding: 6px 12px;
}


#speciality-blurb {
    padding: 10px 16px;
    margin-right: 16px;
    white-space: normal
}
#bio-text {
    padding: 10px 16px;
    margin-right: 16px;
    white-space: normal;
}

#researcher-name {
   margin-top: 4px;
    margin-bottom: 8px;
}

#researcher-bio {
    margin-bottom: 8px;
}
#cost-info {
    padding: 1% 8%;
}



#fame, #speed {
    white-space: nowrap; 
    padding: 10px 16px;       
    background-color: white;
    border-top-right-radius: 10px;
    border-top-left-radius: 10px;
}

#researcher {
    width: 90%;
    background-color: white;
    padding-bottom: 12px;
    margin-bottom: 16px;
    overflow: hidden;
}

#cost-info, #researcher, #speciality-blurb, #back-to-upgrades, #researcher-hire-screen {
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
}


#hire-researcher, #back-to-upgrades-button {
    border-color: transparent;
    background-color: #14248a;
    width: 25%;
    border-radius: 10px;
}

#back-to-upgrades-button {
    background-color: #4d00aa;
    width: 120px;
    min-height: 32px;
    margin: 0;
}



#cost-info {
    flex-grow: 1;
    padding: 8px 16px;
}
#hiring-info {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    margin-right: 16px;  

}

#researcher-stats {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    flex-shrink: 0;    
}
#speed {
    margin-left: 8px; 
}

#hire-researcher {
    width: 120px;
    margin-left: 8px;
}

#researcher-overview {
    flex-wrap: wrap;  
}
