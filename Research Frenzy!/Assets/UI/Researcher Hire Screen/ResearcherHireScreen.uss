/* one centred window. the dim and centring around it come from ModalScreen */
#researcher-hire-screen {
    width: 70%;
    max-width: 1200px;
    min-width: 700px;
    height: 85%;
    flex-direction: column;
    background-color: #F4F3FB;
    border-radius: 10px;
    overflow: hidden;
    color: #2A1B4D;
    -unity-font-style: bold;
}

#header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    flex-shrink: 0;
    background-color: #7300FF;
    padding: 12px 20px;
}

#hire-title {
    color: white;
    font-size: 22px;
}

#back-to-upgrades-button {
    background-color: #8683CC;
    color: white;
    border-width: 0;
    border-radius: 10px;
    padding: 6px 18px;
}

#back-to-upgrades-button:hover, #back-to-upgrades-button:hover:active {
    background-color: #9C99DB;
}

/* the list fills the rest of the window. cards stretch to the full width, with the same gap on both sides */
#researchers {
    flex-grow: 1;
}

#researchers .unity-scroll-view__content-container {
    padding: 16px 16px 4px 16px;
}

/* --- scrollbar, same colours as before --- */

#researchers .unity-scroller--vertical {
    width: 18px;
    margin: 8px 6px 8px 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

#researchers .unity-scroller__low-button,
#researchers .unity-scroller__high-button {
    display: none;
}

#researchers .unity-base-slider__tracker {
    width: 8px;
    background-color: #E4E2F5;
    border-width: 0;
    border-radius: 4px;
}

#researchers .unity-base-slider__dragger {
    width: 8px;
    background-color: #8683CC;
    border-width: 0;
    border-radius: 4px;
}

#researchers .unity-base-slider__dragger:hover {
    background-color: #9C99DB;
}

#researchers .unity-base-slider__dragger:active {
    background-color: #7300FF;
}

#researchers .unity-base-slider__dragger-border {
    display: none;
}
