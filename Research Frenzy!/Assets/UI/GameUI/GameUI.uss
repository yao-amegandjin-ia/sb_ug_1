/* same colors as Yao's screens (shop, match, hire) so everything matches.
   to change the look, change these first */
:root {
    --purple: #7300FF;          /* headers, main buttons */
    --purple-hover: #8C33FF;
    --lavender: #8683CC;        /* close / small buttons, labels */
    --lavender-hover: #9C99DB;
    --navy: #2A1B4D;            /* text */
    --muted: #5A4F7A;           /* secondary text */
    --bg: #F4F3FB;              /* panels */
    --tray: #E4E2F5;            /* soft fills */
    --line: #B9B6D9;
    --orange: #FFA500;          /* money */
    --orange-hover: #FFB733;
    --blue: #0099FF;            /* main action (continue, start) like the MATCH button */
    --blue-hover: #33ADFF;
    --green: #2EB872;           /* best answer */
}

.hidden {
    display: none;
}

#game-ui {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    color: var(--navy);
}

/* ---------- buttons ---------- */

/* .unity-button so it beats the default theme */
.unity-button {
    border-width: 0;
    border-radius: 10px;
    margin: 0;
    -unity-font-style: bold;
}

.small-button {
    background-color: var(--lavender);
    color: white;
    font-size: 16px;
    padding: 8px 14px;
    margin-right: 8px;
}

.close-button {
    background-color: var(--lavender);
    color: white;
    font-size: 16px;
    padding: 6px 18px;
}

/* :hover and :active are listed too, otherwise the default theme turns buttons grey */
.small-button:hover, .small-button:hover:active,
.close-button:hover, .close-button:hover:active {
    background-color: var(--lavender-hover);
}

.big-button {
    font-size: 24px;
    height: 64px;
    min-width: 240px;
    padding: 0 30px;
    margin: 0 12px;
    border-radius: 12px;
}

.primary {
    background-color: var(--blue);
    color: white;
}

.primary:hover, .primary:hover:active {
    background-color: var(--blue-hover);
}

.secondary, .secondary:hover, .secondary:hover:active {
    background-color: white;
    color: var(--lavender);
    border-width: 3px;
    border-color: var(--lavender);
}

.secondary:hover {
    color: var(--purple);
    border-color: var(--purple);
}

.main {
    background-color: var(--purple);
}

.main:hover, .main:hover:active {
    background-color: var(--purple-hover);
}

.dark { background-color: var(--navy); }
.orange { background-color: var(--orange); }
.white { background-color: white; }
.lavender { background-color: var(--lavender); }

/* ---------- top left ---------- */

#top-buttons {
    position: absolute;
    left: 20px;
    top: 20px;
    flex-direction: row;
}

/* ---------- bottom bar ---------- */

#hud {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 120px;
    flex-direction: row;
    align-items: stretch;
    padding: 14px 20px;
    background-color: var(--bg);
    border-top-width: 4px;
    border-top-color: var(--purple);
}

.hud-button {
    width: 230px;
    margin-right: 14px;
    justify-content: center;
    align-items: center;
}

.hud-button-title {
    color: white;
    font-size: 24px;
    -unity-font-style: bold;
}

.hud-button-sub {
    color: white;
    font-size: 15px;
    opacity: 0.85;
}

.hud-card {
    border-radius: 10px;
    padding: 6px 18px;
    margin-right: 14px;
    justify-content: center;
    align-items: center;
    min-width: 200px;
}

.small-card {
    min-width: 140px;
}

.card-label {
    font-size: 15px;
    -unity-font-style: bold;
    color: white;
    opacity: 0.9;
}

.white .card-label {
    color: var(--lavender);
}

.orange .card-label {
    color: var(--navy);
    opacity: 0.75;
}

.card-value {
    font-size: 36px;
    -unity-font-style: bold;
    color: white;
}

.orange .card-value {
    color: var(--navy);
}

#studies {
    width: 480px;
    border-width: 3px;
    border-color: var(--lavender);
    padding-top: 2px;
    padding-bottom: 2px;
}

/* labels have a default margin/padding, take it off so 3 lines fit in the bar */
#hud .unity-label {
    margin: 0;
    padding: 0;
}

#studies .card-label {
    font-size: 13px;
}

.studies-row {
    flex-direction: row;
    width: 100%;
}

.study {
    flex-grow: 1;
    align-items: center;
}

.study-label {
    font-size: 13px;
    margin-top: 2px;
    color: var(--lavender);
    -unity-font-style: bold;
}

.study-count {
    font-size: 28px;
    -unity-font-style: bold;
    color: var(--navy);
}

.spacer {
    flex-grow: 1;
}

/* ---------- side panels (codex, manage firm) ---------- */

.side-panel {
    position: absolute;
    left: 20px;
    top: 80px;
    bottom: 140px;
    width: 520px;
    background-color: var(--bg);
    border-radius: 10px;
    overflow: hidden;
}

.panel-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    background-color: var(--purple);
    padding: 14px 20px;
}

.panel-title {
    color: white;
    font-size: 26px;
    -unity-font-style: bold;
}

.panel-hint {
    color: var(--lavender);
    font-size: 18px;
    -unity-font-style: bold;
    margin: 14px 20px 4px 20px;
}

.panel-scroll {
    flex-grow: 1;
    padding: 10px 20px 20px 20px;
}

.section-title {
    color: var(--purple);
    font-size: 18px;
    -unity-font-style: bold;
    margin-top: 16px;
    margin-bottom: 8px;
}

/* scrollbars like the shop screen */
.panel-scroll .unity-scroller--vertical,
.summary-list .unity-scroller--vertical {
    width: 18px;
    margin: 8px 0 8px 6px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.panel-scroll .unity-scroller__low-button,
.panel-scroll .unity-scroller__high-button,
.summary-list .unity-scroller__low-button,
.summary-list .unity-scroller__high-button {
    display: none;
}

.panel-scroll .unity-base-slider__tracker,
.summary-list .unity-base-slider__tracker {
    width: 8px;
    background-color: var(--tray);
    border-width: 0;
    border-radius: 4px;
}

.panel-scroll .unity-base-slider__dragger,
.summary-list .unity-base-slider__dragger {
    width: 8px;
    background-color: var(--lavender);
    border-width: 0;
    border-radius: 4px;
}

.panel-scroll .unity-base-slider__dragger:hover,
.summary-list .unity-base-slider__dragger:hover {
    background-color: var(--lavender-hover);
}

.panel-scroll .unity-base-slider__dragger:active,
.summary-list .unity-base-slider__dragger:active {
    background-color: var(--purple);
}

.panel-scroll .unity-base-slider__dragger-border,
.summary-list .unity-base-slider__dragger-border {
    display: none;
}

/* codex rows */

.method-row {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    background-color: white;
    border-radius: 10px;
    padding: 10px 14px;
    margin-bottom: 8px;
}

.method-badge {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background-color: var(--purple);
    color: white;
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-right: 14px;
}

.method-name {
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--navy);
}

.method-text {
    white-space: normal;
    font-size: 19px;
    color: var(--navy);
    background-color: var(--tray);
    border-radius: 10px;
    padding: 12px 16px;
    margin: -4px 0 12px 0;
}

/* manage firm */

.firm-card {
    background-color: white;
    border-radius: 10px;
    padding: 12px 16px;
    margin-bottom: 8px;
}

.firm-name {
    font-size: 22px;
    -unity-font-style: bold;
}

.firm-detail {
    font-size: 17px;
    color: var(--muted);
    white-space: normal;
}

.badge-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 8px;
}

.badge-row .method-badge {
    width: 36px;
    height: 36px;
    font-size: 18px;
    margin-right: 8px;
}

.stats-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.stat {
    width: 31%;
    margin-right: 2%;
    margin-bottom: 8px;
    background-color: white;
    border-radius: 10px;
    padding: 8px;
    align-items: center;
}

.stat-label {
    font-size: 14px;
    color: var(--lavender);
    -unity-font-style: bold;
}

.stat-value {
    font-size: 26px;
    -unity-font-style: bold;
}

/* ---------- day summary ---------- */

.modal-bg {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.5);
    justify-content: center;
    align-items: center;
}

.modal {
    width: 760px;
    background-color: var(--bg);
    border-radius: 10px;
    overflow: hidden;
}

.modal-body {
    padding: 24px 30px 30px 30px;
    align-items: stretch;
}

.summary-modal {
    width: 1100px;
    height: 88%;
}

.summary-body {
    flex-grow: 1;
    padding: 20px 28px 24px 28px;
}

/* the five counts across the top */
.summary-tiles {
    flex-direction: row;
    flex-shrink: 0;
    margin: 0 -4px;
}

.summary-tile {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 4px;
    padding: 8px 4px;
    align-items: center;
    background-color: white;
    border-radius: 10px;
    border-width: 3px;
    border-color: var(--line);
}

.summary-tile.best { border-color: var(--green); }
.summary-tile.good { border-color: var(--blue); }
.summary-tile.wrong { border-color: var(--orange); }
.summary-tile.lost { border-color: var(--lavender); }

.tile-value {
    font-size: 30px;
    -unity-font-style: bold;
    color: var(--navy);
}

.tile-label {
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--lavender);
}

/* one card per client from today */
.summary-list {
    flex-grow: 1;
}

.summary-empty {
    color: var(--lavender);
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-top: 30px;
}

.study-card {
    background-color: white;
    border-radius: 10px;
    padding: 14px 18px;
    margin-bottom: 10px;
}

.study-card-top {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
}

.study-client {
    font-size: 20px;
    -unity-font-style: bold;
    color: var(--navy);
}

.result-tag {
    font-size: 14px;
    -unity-font-style: bold;
    color: white;
    padding: 4px 12px;
    border-radius: 12px;
}

.result-tag.best { background-color: var(--green); }
.result-tag.good { background-color: var(--blue); }
.result-tag.wrong { background-color: var(--orange); color: var(--navy); }
.result-tag.lost { background-color: var(--lavender); }

/* the tags and money on the right of a study card's top row */
.study-tags {
    flex-direction: row;
    align-items: center;
}

.study-tags .result-tag {
    margin-left: 6px;
}

.study-reward {
    margin-left: 10px;
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--navy);
}

.study-problem {
    white-space: normal;
    font-size: 17px;
    color: var(--muted);
    margin-bottom: 8px;
}

.answer-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.answer-label {
    width: 150px;
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--lavender);
}

.method-badge.small-badge {
    width: 30px;
    height: 30px;
    font-size: 15px;
    margin-right: 10px;
}

.answer-text {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--navy);
}

/* why the best answer is best, from the request's Rationale */
.study-why {
    white-space: normal;
    font-size: 16px;
    color: var(--navy);
    background-color: var(--tray);
    border-radius: 10px;
    padding: 10px 14px;
    margin-top: 6px;
}

.summary-footer {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-top: 12px;
}

.money-box {
    flex-grow: 1;
    flex-basis: 0;
    background-color: var(--orange);
    border-radius: 10px;
    padding: 8px 10px;
    align-items: center;
    margin-right: 10px;
}

.money-box .card-label {
    color: var(--navy);
    opacity: 0.75;
}

.money-value {
    font-size: 30px;
    -unity-font-style: bold;
    color: var(--navy);
}

.summary-footer .big-button {
    margin: 0;
}

/* ---------- start screen ---------- */

#start-screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--navy);
}

.start-page {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
}

.start-card {
    width: 1300px;
    background-color: var(--bg);
    border-radius: 10px;
    overflow: hidden;
}

.start-header {
    justify-content: center;
    padding: 26px;
}

.start-title {
    color: white;
    font-size: 56px;
    -unity-font-style: bold;
}

.start-body {
    padding: 34px 60px 44px 60px;
    align-items: center;
}

.start-tagline {
    font-size: 28px;
    color: var(--lavender);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 26px;
}

.start-text {
    font-size: 26px;
    color: var(--navy);
    white-space: normal;
    background-color: white;
    border-radius: 10px;
    padding: 30px 36px;
    margin-bottom: 34px;
    width: 100%;
}

.button-row {
    flex-direction: row;
    justify-content: center;
}

.starter-row {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 34px;
}

.starter-card {
    width: 400px;
    background-color: white;
    border-radius: 10px;
    border-width: 4px;
    border-color: white;
    padding: 24px;
    margin: 0 20px;
    align-items: flex-start;
}

.starter-card.selected {
    border-color: var(--purple);
}

.starter-name {
    font-size: 32px;
    -unity-font-style: bold;
    color: var(--navy);
}

.starter-level {
    font-size: 18px;
    color: var(--lavender);
    -unity-font-style: bold;
    margin-bottom: 12px;
}

.starter-method {
    flex-direction: row;
    align-items: center;
    margin-bottom: 14px;
}

.starter-method-name {
    font-size: 20px;
    color: var(--navy);
}

.selected-tag {
    background-color: var(--purple);
    color: white;
    font-size: 16px;
    -unity-font-style: bold;
    padding: 4px 12px;
    border-radius: 10px;
    visibility: hidden;
}

.starter-card.selected .selected-tag {
    visibility: visible;
}

/* clickable rows/cards are buttons too, so keep their colors on hover */
.method-row:hover, .method-row:hover:active {
    background-color: var(--tray);
}

.method-row.open, .method-row.open:hover, .method-row.open:hover:active {
    background-color: var(--tray);
}

.method-row.open .method-name {
    color: var(--purple);
}

.starter-card:hover, .starter-card:hover:active {
    background-color: white;
    border-color: var(--line);
}

.starter-card.selected:hover, .starter-card.selected:hover:active {
    border-color: var(--purple);
}
