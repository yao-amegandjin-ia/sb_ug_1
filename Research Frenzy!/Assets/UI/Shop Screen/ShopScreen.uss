/* the shop window. same look as the old hire screen. the dim and centring around it come from ModalScreen */
#shop-screen {
    width: 70%;
    max-width: 1200px;
    min-width: 700px;
    height: 85%;
    flex-direction: column;
    background-color: #F4F3FB;
    border-radius: 10px;
    overflow: hidden;
    color: #2A1B4D;
    -unity-font-style: bold;
}

#header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    flex-shrink: 0;
    background-color: #7300FF;
    padding: 12px 20px;
}

#shop-title {
    color: white;
    font-size: 22px;
}

#header-right {
    flex-direction: row;
    align-items: center;
}

/* money pill, so the player can see what they can afford */
#shop-money {
    color: #2A1B4D;
    background-color: #FFA500;
    border-radius: 10px;
    padding: 6px 14px;
    margin-right: 12px;
    font-size: 16px;
}

#close-button {
    background-color: #8683CC;
    color: white;
    border-width: 0;
    border-radius: 10px;
    padding: 6px 18px;
}

#close-button:hover, #close-button:hover:active {
    background-color: #9C99DB;
}

/* --- tabs: pills like the method buttons. the open one is filled purple --- */

#tab-bar {
    flex-direction: row;
    flex-shrink: 0;
    padding: 12px 16px 0 16px;
}

.shop-tab {
    height: 36px;
    margin: 0 8px 0 0;
    padding: 0 18px;
    border-radius: 18px;
    border-width: 3px;
    border-color: #8683CC;
    background-color: white;
    color: #8683CC;
    font-size: 15px;
    -unity-font-style: bold;
}

.shop-tab:hover, .shop-tab:hover:active {
    border-color: #7300FF;
    color: #7300FF;
}

.shop-tab.selected, .shop-tab.selected:hover {
    background-color: #7300FF;
    border-color: #7300FF;
    color: white;
}

/* shown when a tab has nothing in it */
.shop-empty {
    color: #8683CC;
    font-size: 16px;
    -unity-text-align: middle-center;
    margin-top: 40px;
}

/* the list fills the rest of the window. cards stretch to the full width, with the same gap on both sides */
#shop-list {
    flex-grow: 1;
}

#shop-list .unity-scroll-view__content-container {
    padding: 16px 16px 4px 16px;
}

/* --- scrollbar, same colours as the hire screen --- */

#shop-list .unity-scroller--vertical {
    width: 18px;
    margin: 8px 6px 8px 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

#shop-list .unity-scroller__low-button,
#shop-list .unity-scroller__high-button {
    display: none;
}

#shop-list .unity-base-slider__tracker {
    width: 8px;
    background-color: #E4E2F5;
    border-width: 0;
    border-radius: 4px;
}

#shop-list .unity-base-slider__dragger {
    width: 8px;
    background-color: #8683CC;
    border-width: 0;
    border-radius: 4px;
}

#shop-list .unity-base-slider__dragger:hover {
    background-color: #9C99DB;
}

#shop-list .unity-base-slider__dragger:active {
    background-color: #7300FF;
}

#shop-list .unity-base-slider__dragger-border {
    display: none;
}
