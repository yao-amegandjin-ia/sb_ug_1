<?xml version="1.0" encoding="utf-8"?>
<ui:UXML
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ui="UnityEngine.UIElements"
    xmlns:uie="UnityEditor.UIElements"
    xsi:noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd"
>
    <ui:VisualElement name="researcher-referral-screen">
        <ui:VisualElement name="header">
            <ui:Label name="client-name" text="Alice Smith"/>
            <ui:Button name="close-btn" text="CLOSE"/>
        </ui:VisualElement>

        <ui:VisualElement name="problem-statement">
            <ui:Label name="problem-text" text="We want to understand why some college students choose not to attend professor office hours."/>
        </ui:VisualElement>

        <ui:VisualElement name="referral-options">
            <ui:VisualElement name="help-option" class="option">
                <ui:Label class="option-title" text="WE CAN HELP WITH THAT"/>
                <ui:Label class="option-desc" text="A researcher is free to take your request now."/>
            </ui:VisualElement>
            <ui:VisualElement name="wait-option" class="option">
                <ui:Label class="option-title" text="PLEASE WAIT"/>
                <ui:Label class="option-desc" text="Our researcher is with another visitor right now."/>
            </ui:VisualElement>
            <ui:VisualElement name="tomorrow-option" class="option">
                <ui:Label class="option-title" text="COME BACK TOMORROW"/>
                <ui:Label class="option-desc" text="Good question, but we don't have a researcher free yet."/>
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
