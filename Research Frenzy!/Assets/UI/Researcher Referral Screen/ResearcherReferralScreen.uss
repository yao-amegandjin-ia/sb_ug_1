/* left side panel, same spot and size as the request screen it replaces */
#researcher-referral-screen {
    position: absolute;
    left: 20px;
    top: 80px;
    bottom: 140px;
    width: 25%;
    min-width: 360px;
    flex-direction: column;
    background-color: #F4F3FB;
    border-radius: 10px;
    overflow: hidden;
    -unity-font-style: bold;
}

#header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    flex-shrink: 0;
    background-color: #7300FF;
    padding: 12px 16px;
}

#client-name {
    font-size: 20px;
    color: #FFFFFF;
    white-space: normal;
    flex-shrink: 1;
}

#close-btn {
    background-color: #8683CC;
    color: #FFFFFF;
    border-width: 0;
    border-radius: 10px;
    flex-shrink: 0;
}

#close-btn:hover, #close-btn:hover:active {
    background-color: #9C99DB;
}

/* fills the space between the header and the buttons, and centres the text in it,
   so the buttons stay at the bottom and 3-4 sentences have room */
#problem-statement {
    flex-grow: 1;
    justify-content: center;
    padding: 24px 28px;
}

#problem-text {
    color: #2A1B4D;
    font-size: 18px;
    white-space: normal;
    -unity-text-align: middle-center;
}

#referral-options {
    flex-direction: column;
    flex-shrink: 0;
    padding: 0 20px 8px 20px;
}

.option {
    flex-shrink: 0;
    padding: 12px 16px;
    margin: 0 0 12px 0;
    border-width: 0;
    border-radius: 12px;
    -unity-text-align: middle-left;
}

.option-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: #FFFFFF;
    white-space: normal;
}

.option-desc {
    font-size: 14px;
    -unity-font-style: normal;
    color: #FFFFFF;
    white-space: normal;
}

#help-option {
    background-color: #0099FF;
}

#help-option:hover, #help-option:hover:active {
    background-color: #33ADFF;
}

#wait-option {
    background-color: #8683CC;
}

#wait-option:hover, #wait-option:hover:active {
    background-color: #9C99DB;
}

#tomorrow-option {
    background-color: #FFA500;
}

#tomorrow-option:hover, #tomorrow-option:hover:active {
    background-color: #FFB733;
}

#tomorrow-option .option-title,
#tomorrow-option .option-desc {
    color: #2A1B4D;
}
