#methodologies {
    background-color: transparent;
    display: flex;
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    align-content: flex-start;
    flex-wrap: wrap;
    -unity-font-style: bold;
}

/* unlocked (usable) */
#methodologies Button {
    height: 32px;
    margin: 4px;
    padding: 0 12px;
    border-radius: 15px;
    border-width: 3px;
    border-color: #8683CC;
    background-color: #8683CC;
    color: white;
    white-space: nowrap;
    -unity-text-align: middle-center;
}

#methodologies Button:enabled:hover {
    background-color: white;
    border-color: #7300FF;
    color: #7300FF;
}

#methodologies Button:disabled {
    background-color: #CFCDE6;
    border-color: #CFCDE6;
    color: #5E5AA8;
}

#methodologies #methodology-one.selected,
#methodologies #methodology-two.selected,
#methodologies #methodology-three.selected,
#methodologies #methodology-four.selected {
    background-color: white;
    border-color: #7300FF;
    color: #7300FF;
}
