
#header {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    background-color: #7300FF;
    color: white;
    padding: 12px 16px;
    border-top-right-radius: 10px;
    border-top-left-radius: 10px;
}

#client-name {
    font-size: 20px;
}
#researcher-request-screen {
   background-color: #F4F3FB;
   display: flex;
   flex-direction: column;
   justify-content: space-between;
   height: 85%;
   width: 90%;
   padding-bottom: 5%;
   -unity-font-style: bold;
}

#problem-text {
    align-self: center;
    color: #2A1B4D;
}

#problem-text, #decision-btns Button {
    font-size: 18px;
}
#close-btn{
    background-color: #8683CC;
    border-width: 0;
}

#close-btn, #decision-btns Button, #researcher-request-screen {
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-top-left-radius: 10px;
    border-bottom-left-radius: 10px;
}

#accept-btn {
    background-color: #0099FF;
    color: white;
}

#deny-btn {
    background-color: #FFA500;
    color: #2A1B4D;
}
#decision-btns Button {
    flex-basis: 25%;
    white-space: normal;
    flex-shrink: 0;
    border-width: 0;
}
#decision-btns {
    display: flex;
    flex-direction: row;
    justify-content: space-around;
}

#accept-btn:hover {
    background-color: #33ADFF;
}

#deny-btn:hover {
    background-color: #FFB733;
}


#close-btn:hover {
    background-color: #9C99DB;
}